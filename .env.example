# VCBlogger 4.0 — safe defaults. Fill ONLY the credentials and one DB URL.
# Copy this file to .env. Never share your .env or SESSION_STRING.

# Required Bot API credentials. Assistant sessions are optional for command responsiveness;
# detailed participant join/leave tracking requires at least one logged-in user session.
BOT_TOKEN=
API_ID=
API_HASH=
SESSION_STRING=
# Optional: up to two additional logged-in user sessions, comma-separated (3 sessions total max)
ASSISTANT_SESSION_STRINGS=

# Database: leave DB_PROVIDER=auto and configure ONE URL below.
# If multiple URLs are filled, selection priority is MongoDB > PostgreSQL > Redis.
DB_PROVIDER=auto
DATABASE_NAME=vcblogger
MONGO_URI=
POSTGRES_URL=
REDIS_URL=

# Owner numeric Telegram IDs, comma-separated; required for DM alerts.
SUDO_USERS=

# VC tracking defaults
MIN_DURATION_THRESHOLD=5
SNAPSHOT_INTERVAL=10
AUTO_RECOVERY=true
# Number of accessible group dialogs to inspect for a voice chat already active at startup.
VC_STARTUP_DISCOVERY_LIMIT=100
# Reconcile the current participant roster of known active calls every 60 seconds.
VC_RECONCILE_INTERVAL_SECONDS=15

# Join/leave alerts in the group. Seconds before they are deleted; 0 keeps them.
VC_EVENT_NOTIFICATIONS=true
VC_EVENT_MESSAGE_TTL_SECONDS=10

# Historical sessions, incidents, attendance, and voice-time detail are preserved.
# The old retention variables are ignored for history deletion (kept for compatibility).
SESSION_RETENTION_DAYS=90
INCIDENT_RETENTION_DAYS=30
ATTENDANCE_DEDUPE_RETENTION_DAYS=180
CLEANUP_INTERVAL_HOURS=24

# Storage warnings: 0 uses conservative provider-specific soft limits
# (Redis 100 MiB; MongoDB/PostgreSQL 400 MiB). This is NOT provider quota detection.
STORAGE_LIMIT_MB=0
STORAGE_ALERT_INTERVAL_HOURS=6

# Local compressed backups; use persistent disk on cloud deployments.
BACKUP_ENABLED=true
BACKUP_DIR=./backups
BACKUP_RETENTION_COUNT=3
BACKUP_INTERVAL_HOURS=24
BACKUP_INITIAL_DELAY_SECONDS=60

# Period stats use India time by default
STATS_TIMEZONE=Asia/Kolkata
